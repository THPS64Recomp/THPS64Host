diff --git a/src/hle/rt64_hfr_stats.h b/src/hle/rt64_hfr_stats.h
new file mode 100644
index 0000000..322c1d6
--- /dev/null
+++ b/src/hle/rt64_hfr_stats.h
@@ -0,0 +1,37 @@
+//
+// RT64
+//
+// [thps-recomp] Frame-interpolation counters (pairing of transforms between game frames, frames
+// generated), read by the host for its perf log. Written only by the workload thread.
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+namespace RT64 {
+    struct HfrStats {
+        std::atomic<uint64_t> framesMatched{ 0 };       // Game frames that went through GameFrame::match.
+        std::atomic<uint64_t> framesInterpolating{ 0 }; // ...of which generated interpolated frames.
+        std::atomic<uint64_t> transforms{ 0 };          // World transforms seen in matched frames.
+        std::atomic<uint64_t> transformsPaired{ 0 };    // ...paired with one of the previous frame (interpolated).
+        std::atomic<uint64_t> transformsSkipped{ 0 };   // ...tagged G_EX_ID_IGNORE (never interpolated).
+        std::atomic<uint64_t> viewProjs{ 0 };           // View-projections seen in matched frames.
+        std::atomic<uint64_t> viewProjsPaired{ 0 };     // ...paired (camera interpolated).
+        std::atomic<uint64_t> displayFrames{ 0 };       // Frames rendered for presentation (interpolated included).
+        std::atomic<uint64_t> displayFramesDropped{ 0 };// Interpolated frames skipped for lack of time.
+        std::atomic<uint64_t> workloads{ 0 };           // Workloads (game frames) rendered.
+        std::atomic<uint64_t> renderMicros{ 0 };        // Time spent rendering them (all display frames, GPU waits included).
+        std::atomic<uint64_t> renderMicrosMax{ 0 };     // Longest single workload (reset by the reader).
+
+        // Debugging: when collect is set, the next matched frame's world transforms are stored as
+        // (physical matrix address << 2) | (paired ? 1 : 0) | (skipped ? 2 : 0), then collect is cleared.
+        std::atomic<bool> collect{ false };
+        std::mutex collectedMutex;
+        std::vector<uint64_t> collected;
+    };
+
+    extern HfrStats hfrStats;
+};
