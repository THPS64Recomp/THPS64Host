+    void PresentQueue::threadCapture(RenderTarget *colorTarget, const Present &present, UserConfiguration::Filtering filtering, bool removeBlackBorders, uint64_t presentIndex, bool shownInWindow, bool readback, bool drawUi) {
+        uint32_t width = captureWidth;
+        uint32_t height = captureHeight;
+        if ((width == 0) || (height == 0)) {
+            width = ext.swapChain->getWidth();
+            height = ext.swapChain->getHeight();
+        }
+
+        if ((width == 0) || (height == 0)) {
+            return;
+        }
+
+        const RenderFormat captureFormat = RenderFormat::B8G8R8A8_UNORM; // Same as the VI pipelines and the swap chain.
+        if ((captureTexture == nullptr) || (captureTextureWidth != width) || (captureTextureHeight != height)) {
+            captureFramebuffer.reset();
+            captureTexture = ext.device->createTexture(RenderTextureDesc::ColorTarget(width, height, captureFormat));
+            const RenderTexture *captureTexturePtr = captureTexture.get();
+            captureFramebuffer = ext.device->createFramebuffer(RenderFramebufferDesc(&captureTexturePtr, 1));
+            captureRowPitch = ((width * 4) + 255) & ~255U;
+            captureReadback = ext.device->createBuffer(RenderBufferDesc::ReadbackBuffer(uint64_t(captureRowPitch) * height));
+            captureTextureWidth = width;
+            captureTextureHeight = height;
+        }
+
+        RenderCommandList *commandList = ext.presentGraphicsWorker->commandList.get();
+        commandList->begin();
+        commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(captureTexture.get(), RenderTextureLayout::COLOR_WRITE));
+
+        VIRenderer::RenderParams renderParams;
+        renderParams.device = ext.device;
+        renderParams.commandList = commandList;
+        renderParams.swapChain = ext.swapChain;
+        renderParams.shaderLibrary = ext.shaderLibrary;
+        renderParams.textureFormat = colorTarget->format;
+        renderParams.resolutionScale = colorTarget->resolutionScale;
+        renderParams.downsamplingScale = 1;
+        renderParams.filtering = filtering;
+        renderParams.vi = &present.screenVI;
+        renderParams.removeBlackBorders = removeBlackBorders;
+        renderParams.targetWidth = width;
+        renderParams.targetHeight = height;
+        if (colorTarget->downsampleMultiplier > 1) {
+            colorTarget->downsampleTarget(ext.presentGraphicsWorker, ext.shaderLibrary);
+            renderParams.texture = colorTarget->downsampledTexture.get();
+            renderParams.textureWidth = colorTarget->width / colorTarget->downsampleMultiplier;
+            renderParams.textureHeight = colorTarget->height / colorTarget->downsampleMultiplier;
+            renderParams.downsamplingScale = colorTarget->downsampleMultiplier;
+        }
+        else {
+            colorTarget->resolveTarget(ext.presentGraphicsWorker, ext.shaderLibrary);
+            renderParams.texture = colorTarget->getResolvedTexture();
+            renderParams.textureWidth = colorTarget->width;
+            renderParams.textureHeight = colorTarget->height;
+        }
+
+        commandList->setFramebuffer(captureFramebuffer.get());
+        commandList->clearColor();
+        if (renderParams.texture != nullptr) {
+            commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(renderParams.texture, RenderTextureLayout::SHADER_READ));
+            viRenderer->render(renderParams);
+        }
+
+        if (drawUi) {
+            RenderHookDraw *drawHook = GetRenderHookDraw();
+            if (drawHook != nullptr) {
+                drawHook(commandList, captureFramebuffer.get());
+            }
+        }
+
+        if (readback) {
+            commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(captureTexture.get(), RenderTextureLayout::COPY_SOURCE));
+            commandList->copyTextureRegion(
+                RenderTextureCopyLocation::PlacedFootprint(captureReadback.get(), captureFormat, width, height, 1, captureRowPitch / 4),
+                RenderTextureCopyLocation::Subresource(captureTexture.get()));
+        }
+        commandList->end();
+        ext.presentGraphicsWorker->execute();
+        ext.presentGraphicsWorker->wait();
+        if (!readback) {
+            return;
+        }
+
+        Capture capture;
+        capture.bgra = reinterpret_cast<const uint8_t *>(captureReadback->map());
+        capture.width = width;
+        capture.height = height;
+        capture.rowPitch = captureRowPitch;
+        capture.presentIndex = presentIndex;
+        capture.shownInWindow = shownInWindow;
+        capture.fbAddress = present.screenVI.fbAddress();
+        capture.fbWidth = present.screenVI.fbSize().x;
+        capture.fbHeight = present.screenVI.fbSize().y;
+        capture.fbSiz = present.screenVI.fbSiz();
+        if (capture.bgra != nullptr) {
+            captureCallback(capture);
+            captureReadback->unmap();
+            captureCount++;
+        }
+    }
