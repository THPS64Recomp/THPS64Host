new file mode 100644
--- /dev/null
+++ b/src/render/rt64_split_screen.h
@@ -0,0 +1,76 @@
+//
+// RT64
+//
+// [thps-recomp] Split screen in widescreen. RT64 widens a 3D view (stretched viewport, widened projection) only when its
+// viewport spans the whole width of the framebuffer pair's scissor and is wider than tall. A two-player split screen draws
+// two side-by-side views, each half the width and taller than wide, so both stay in the centred 4:3 area. With
+// splitScreenWide set (the host sets it; off by default, upstream behaviour), a view that fills one side of the pair's
+// scissor up to its middle (and most of its height), in a pair that has such a view on both sides, is widened like a
+// full-width one: its viewport stretches with the frame from the left edge, so the left half covers the left half of the
+// wide frame and the right half the right one, and its projection gets the same aspect adjustment. A fill rect covering
+// such a half (a per-view clear) stretches with it.
+// With splitScreenBlackBands set (the host sets it; off by default, upstream behaviour) and splitScreenWide off (the host's
+// `split = original`), the two views stay in the 4:3 area. A colour fill across the whole
+// width (the game's frame clear, often the sky colour) would still be stretched over the side bands by the upstream rule, and
+// they would show it around the views. In such a pair the fill clears the stretched rect to black and then its own colour
+// only over the 4:3 area, so the bands are black as on a TV (splitScreenBands counts these fills).
+
+#pragma once
+
+#include <atomic>
+#include <cstdlib>
+
+#include "common/rt64_common.h"
+
+namespace RT64 {
+    extern std::atomic<bool> splitScreenWide;
+    extern std::atomic<bool> splitScreenBlackBands;
+
+    // Counters for the host's diagnostics (written by the render thread).
+    extern std::atomic<uint64_t> splitScreenViews;   // Projections widened by the split-screen rule.
+    extern std::atomic<uint64_t> splitScreenFills;   // Fill rects stretched with a split-screen half.
+    extern std::atomic<uint64_t> splitScreenBands;   // Whole-width colour fills of an unwidened split screen kept black in the side bands.
+
+    // r: a projection's scissor-viewport intersection (or a fill rect); pair: the framebuffer pair's scissor. True when r is
+    // one of two side-by-side halves: it touches the left or the right side of pair, ends near its middle, and spans at least
+    // three quarters of its height. The slack is 1/32 of the width (THPS insets its 3D scissor by 8 px of 320).
+    // The shape alone, whatever splitScreenWide says.
+    inline bool isSplitScreenHalfShape(const FixedRect &r, const FixedRect &pair) {
+        if (r.isEmpty() || pair.isEmpty()) {
+            return false;
+        }
+
+        const int32_t width = pair.lrx - pair.ulx;
+        const int32_t slack = width / 32;
+        const int32_t middle = (pair.ulx + pair.lrx) / 2;
+        const bool leftHalf = (r.ulx <= (pair.ulx + slack)) && (std::abs(r.lrx - middle) <= slack);
+        const bool rightHalf = ((r.lrx + slack) >= pair.lrx) && (std::abs(r.ulx - middle) <= slack);
+        const bool tall = (r.lry - r.uly) * 4 >= (pair.lry - pair.uly) * 3;
+        return (leftHalf != rightHalf) && tall;
+    }
+
+    inline bool isSplitScreenHalf(const FixedRect &r, const FixedRect &pair) {
+        return splitScreenWide.load(std::memory_order_relaxed) && isSplitScreenHalfShape(r, pair);
+    }
+
+    // Which halves (bit 0: left, bit 1: right) the views of a framebuffer pair cover: a projection is only widened by the split-screen rule
+    // when the pair has both (two side-by-side views), so a lone half-width 3D viewport (a model on a menu screen) keeps the upstream rule.
+    // rectOf(i): projection i's scissor-viewport intersection, or an empty rect for one that has no viewport.
+    // anyWide: count the halves whatever splitScreenWide says (the black side bands of an unwidened split screen).
+    template<typename RectOf>
+    inline uint32_t splitScreenHalves(uint32_t projectionCount, RectOf rectOf, const FixedRect &pair, bool anyWide = false) {
+        uint32_t mask = 0;
+        if (!anyWide && !splitScreenWide.load(std::memory_order_relaxed)) {
+            return mask;
+        }
+
+        for (uint32_t i = 0; i < projectionCount; i++) {
+            const FixedRect r = rectOf(i);
+            if (isSplitScreenHalfShape(r, pair)) {
+                mask |= ((r.ulx + r.lrx) < (pair.ulx + pair.lrx)) ? 1U : 2U;
+            }
+        }
+
+        return mask;
+    }
+};
