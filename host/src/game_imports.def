// The names the generated game code imports from the engine, in table order (src/game_abi.h).
// Kinds: CTX = void f(uint8_t* rdram, recomp_context* ctx); the other kinds are spelled out in game_lib.cpp.
// The runtime's libultra stand-ins (*_recomp), the host's hook functions (thps_hooks.h) and the four runtime
// helpers the generated C calls. Regenerate with: nm -u on the game objects (see the THPS1 repository's docs/internals/recomp.md).
// A name missing here fails the game library's link ("undefined symbol"), loudly.
THPS_IMPORT(CTX, __ll_div_recomp)
THPS_IMPORT(CTX, __ll_mul_recomp)
THPS_IMPORT(CTX, __osCheckPackId_recomp)
THPS_IMPORT(CTX, __osContAddressCrc_recomp)
THPS_IMPORT(CTX, __osContRamRead_recomp)
THPS_IMPORT(CTX, __osContRamWrite_recomp)
THPS_IMPORT(CTX, __osDisableInt_recomp)
THPS_IMPORT(CTX, __osEnqueueThread_recomp)
THPS_IMPORT(CTX, __osPfsRWInode_recomp)
THPS_IMPORT(CTX, __osPfsSelectBank_recomp)
THPS_IMPORT(CTX, __osPiCreateAccessQueue_recomp)
THPS_IMPORT(CTX, __osPopThread_recomp)
THPS_IMPORT(CTX, __osRepairPackId_recomp)
THPS_IMPORT(CTX, __osRestoreInt_recomp)
THPS_IMPORT(CTX, __osSetFpcCsr_recomp)
THPS_IMPORT(CTX, __osSiCreateAccessQueue_recomp)
THPS_IMPORT(CTX, __osTimerInterrupt_recomp)
