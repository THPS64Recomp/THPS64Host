// as a thps::Payload. Compiled with -include <class>/namespace.h, so every name the class's generated C
// defines is prefixed "@THPS_CLASS@_" and several classes link into one executable. The static
// tables below are internal to this translation unit. Games with front-end overlays (game/game.toml `overlays`)
// add the class's overlay table, versions/<class>/overlay_table.inc.
#include "versions.h"
