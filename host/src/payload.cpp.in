    sizeof(overlay_sections_by_index) / sizeof(overlay_sections_by_index[0]), recomp_entrypoint
#if @THPS_HAS_OVERLAYS@
    , k_overlays, sizeof(k_overlays) / sizeof(k_overlays[0])
#endif
};
const thps::PayloadRegistrar k_registrar{k_payload};
