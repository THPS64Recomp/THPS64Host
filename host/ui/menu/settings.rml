<rml>
<head>
    <link type="text/rcss" href="rml.rcss"/>
    <link type="text/rcss" href="recomp.rcss"/>
    <title>Settings</title>
    <style>
        body { width: 100%; height: 100%; }
        .menu-title { padding: 18dp 28dp 0dp 28dp; font-size: 22dp; color: #8d8ca0; }
        /* Every tab scrolls when its rows do not fit the panel (a small window: the Graphics tab at 1280x720 ran into the footer); pad and
           arrow navigation scroll the focused row into view (src/ui/ui_host.cpp nav_fallback). Controls tab: the Controllers list and the binding rows */
        .ctl-scroll { overflow-y: auto; }
        .ctl-panel { height: 100%; }
        .ctl-panel .config__hz-wrapper { flex: 1 1 0dp; }
        .ctl-section { width: 100%; }
        .ctl-pad, .ctl-row { display: flex; flex-direction: row; align-items: center; width: 100%; padding: 2dp 12dp; }
        .ctl-pad__name { flex: 3 1 0dp; color: #CCCCCC; }
        .ctl-pad__player { flex: 1.4 1 0dp; color: #F2F2F2; }
        .ctl-pad__player--none { color: #8d8ca0; }
        .ctl-pad__pressed { flex: 1.6 1 0dp; color: #8d8ca0; white-space: nowrap; overflow: hidden; }
        .ctl-pad__pressed--on { color: #52E0A0; }
        .ctl-btn { display: block; flex: 0 0 auto; margin: 4dp 6dp; padding: 8dp 14dp; border-width: 1.1dp; border-radius: 8dp;
                   border-color: rgba(185, 125, 242, 204); background-color: rgba(185, 125, 242, 13); color: #CCCCCC; cursor: pointer; }
        .ctl-btn--wide { flex: 0 0 auto; }
        .ctl-btn--on { background-color: rgba(185, 125, 242, 128); color: #F2F2F2; }
        .ctl-btn:focus, .ctl-btn:hover { border-color: #B97DF2; background-color: rgba(185, 125, 242, 76); color: #F2F2F2; }
        .ctl-row--head { color: #8d8ca0; }
        .ctl-row__label { flex: 3 1 0dp; color: #CCCCCC; white-space: nowrap; overflow: hidden; }
        .ctl-row__head { flex: 2 1 0dp; padding-left: 6dp; }
        .ctl-row__reset-head { flex: 0 0 104dp; }
        .ctl-slot { display: block; flex: 1 1 0dp; margin: 3dp 6dp; padding: 8dp 6dp; text-align: center; white-space: nowrap; overflow: hidden;
                    border-width: 1.1dp; border-radius: 8dp; border-color: rgba(190, 184, 219, 26); background-color: rgba(190, 184, 219, 26);
                    color: #CCCCCC; cursor: pointer; }
        .ctl-slot:focus, .ctl-slot:hover { border-color: #F2F2F2; background-color: rgba(255, 255, 255, 26); color: #F2F2F2; }
        /* A slot whose binding differs from the layout's default (src/ui/ui_host.cpp BindRow m0-m3); a capture's colour wins */
        .ctl-slot--changed { border-color: #F2C14E; color: #F2C14E; }
        .ctl-slot--changed:focus, .ctl-slot--changed:hover { border-color: #F2C14E; color: #F2C14E; }
        .ctl-slot--capture, .ctl-slot--capture:focus { border-color: #F86039; color: #F86039; }
        .ctl-reset { flex: 0 0 92dp; text-align: center; padding: 8dp 4dp; }
        .ctl-status { flex: 0 0 auto; padding: 10dp 28dp; min-height: 22dp; color: #F2C14E; background-color: rgba(0, 0, 0, 89);
                      border-bottom-right-radius: 16dp; border-bottom-left-radius: 16dp; }
    </style>
</head>
<body class="window">
    <div id="window" class="rmlui-window" style="display:flex; flex-flow: column; background-color:rgba(0,0,0,0); pointer-events: auto">
        <div class="centered-page">
            <div class="centered-page__modal">
                <div class="menu-title" data-model="app_model">{{game_title}} - Settings</div>
                <tabset class="tabs" id="config_tabset">
                <tab class="tab" autofocus id="tab_general">
                    <div>General</div>
                    <div class="tab__indicator"></div>
                </tab>
                <panel class="config ctl-panel" data-model="general_model">
                    <form class="config__form">
                        <div class="config__hz-wrapper">
                            <div class="config__wrapper ctl-scroll">
                    <div class="config-option">
                        <label class="config-option__title">Skip Intro</label>
                        <div class="config-option__list">
                            <input type="radio" name="skip_intro" data-checked="skip_intro" value="On" id="si_On" />
                            <label class="config-option__tab-label" id="lbl_si_On" for="si_On">On</label>
                            <input type="radio" name="skip_intro" data-checked="skip_intro" value="Off" id="si_Off" />
                            <label class="config-option__tab-label" id="lbl_si_Off" for="si_Off">Off</label>
                            <div class="config-option__details">Start at the title screen: no logos or legal screens.</div>
                        </div>
                    </div>
                    <div class="config-option">
                        <label class="config-option__title">Show FPS in Window Title</label>
                        <div class="config-option__list">
                            <input type="radio" name="show_fps" data-checked="show_fps" value="On" id="fps_On" />
                            <label class="config-option__tab-label" id="lbl_fps_On" for="fps_On">On</label>
                            <input type="radio" name="show_fps" data-checked="show_fps" value="Off" id="fps_Off" />
                            <label class="config-option__tab-label" id="lbl_fps_Off" for="fps_Off">Off</label>
                        </div>
                    </div>
                            </div>
                        </div>
                    </form>
                </panel>
                <tab class="tab" id="tab_controls">
                    <div>Controls</div>
                    <div class="tab__indicator"></div>
                </tab>
                <panel class="config ctl-panel" data-model="controls_model">
                    <form class="config__form">
                        <div class="config__hz-wrapper">
                            <div class="config__wrapper ctl-scroll">
                    <div class="config-option">
                        <label class="config-option__title">Controller Layout</label>
                        <div class="config-option__list">
                            <input type="radio" name="preset" data-checked="preset" value="thps-xbox" id="cl_thps_xbox" />
                            <label class="config-option__tab-label" id="lbl_cl_thps_xbox" for="cl_thps_xbox">Face buttons (default)</label>
                            <input type="radio" name="preset" data-checked="preset" value="n64" id="cl_n64" />
                            <label class="config-option__tab-label" id="lbl_cl_n64" for="cl_n64">N64 layout (C buttons on right stick)</label>
                            <div class="config-option__details">Keyboard and controller. Picking a layout resets every binding below to it (a .bak copy of controls.cfg is kept).</div>
                        </div>
                    </div>
                    <div class="config-option" data-if="preset_is_custom">
                        <p>Your bindings are your own (custom), so neither layout is selected. Picking one replaces them.</p>
                    </div>
                    <div class="config-option ctl-section">
                        <label class="config-option__title">Controllers</label>
                        <div class="ctl-pad" data-for="pad, pi : pads">
                            <div class="ctl-pad__name">{{pad.name}}</div>
                            <div class="ctl-pad__player" data-class-ctl-pad__player--none="pad.player == 0">{{pad.player_text}}</div>
                            <div class="ctl-pad__pressed" data-class-ctl-pad__pressed--on="pad.pressing">{{pad.pressed}}</div>
                            <button class="ctl-btn nav-all" data-attr-id="'pad' + pi + '_p1'" data-class-ctl-btn--on="pad.player == 1" data-event-click="set_player(pi, 1)">Player 1</button>
                            <button class="ctl-btn nav-all" data-attr-id="'pad' + pi + '_p2'" data-class-ctl-btn--on="pad.player == 2" data-event-click="set_player(pi, 2)">Player 2</button>
                        </div>
                        <div class="ctl-pad" data-if="pads.size == 0">
                            <div class="ctl-pad__name">No controller connected. Plug one in or pair one at any time.</div>
                        </div>
                        <div class="ctl-pad">
                            <div class="ctl-pad__name">Keyboard</div>
                            <div class="ctl-pad__player">Player 1 (always)</div>
                            <div class="ctl-pad__pressed"></div>
                            <button class="ctl-btn ctl-btn--wide nav-all" id="swap_players" data-event-click="swap_players">Swap players 1 and 2</button>
                        </div>
                        <div class="config-option__details">A controller takes the first free player when it presses a button. Use Player 1 / Player 2 to choose instead (the controller there swaps with it). With one controller on Player 2, the keyboard plays player 1 alone. The choice lasts until you quit.</div>
                    </div>
                    <div class="config-option ctl-section">
                        <label class="config-option__title">Bindings</label>
                        <div class="ctl-row ctl-row--head">
                            <div class="ctl-row__label">Action (N64 input)</div>
                            <div class="ctl-row__head">Controller</div>
                            <div class="ctl-row__head">Keyboard</div>
                            <div class="ctl-row__reset-head"></div>
                        </div>
                        <div class="ctl-row" data-for="row, i : rows">
                            <div class="ctl-row__label">{{row.label}}</div>
                            <button class="ctl-slot nav-all" data-attr-id="'bp0_' + row.id" data-class-ctl-slot--capture="row.cap == 1" data-class-ctl-slot--changed="row.m0" data-event-click="rebind(i, 0, 0)">{{row.p0}}</button>
                            <button class="ctl-slot nav-all" data-attr-id="'bp1_' + row.id" data-class-ctl-slot--capture="row.cap == 2" data-class-ctl-slot--changed="row.m1" data-event-click="rebind(i, 0, 1)">{{row.p1}}</button>
                            <button class="ctl-slot nav-all" data-attr-id="'bk0_' + row.id" data-class-ctl-slot--capture="row.cap == 3" data-class-ctl-slot--changed="row.m2" data-event-click="rebind(i, 1, 0)">{{row.k0}}</button>
                            <button class="ctl-slot nav-all" data-attr-id="'bk1_' + row.id" data-class-ctl-slot--capture="row.cap == 4" data-class-ctl-slot--changed="row.m3" data-event-click="rebind(i, 1, 1)">{{row.k1}}</button>
                            <button class="ctl-btn ctl-reset nav-all" data-attr-id="'brs_' + row.id" data-event-click="reset_row(i)">Default</button>
                        </div>
                        <div class="ctl-row">
                            <div class="ctl-row__label">A yellow slot differs from the layout above.</div>
                            <button class="ctl-btn nav-all" id="reset_all" data-event-click="reset_all">{{reset_all_label}}</button>
                        </div>
                        <div class="config-option__details">Choose a slot, then press the button, trigger or stick direction (controller) or the key (keyboard) for it: Back or Esc cancels, Backspace or Delete empties the slot, and after 5 seconds it gives up. A button another action already uses moves here, and that action gets this slot's old button (a swap). Menu accept / back may share a button with a trick, as the default layout does. Default puts one action back as the layout has it; Reset all puts every action back (it asks first). Saved to controls.cfg in {{config_dir}} at once.</div>
                    </div>
                            </div>
                        </div>
                        <div class="ctl-status" id="bind_status">{{bind_status}}</div>
                    </form>
                </panel>
                <tab class="tab" id="tab_graphics">
                    <div>Graphics</div>
                    <div class="tab__indicator"></div>
                </tab>
                <panel class="config ctl-panel" data-model="graphics_model">
                    <form class="config__form">
                        <div class="config__hz-wrapper">
                            <div class="config__wrapper ctl-scroll">
                    <div class="config-option">
                        <label class="config-option__title">Preset</label>
                        <div class="config-option__list">
                            <input type="radio" name="gfx_preset" data-checked="gfx_preset" value="original" id="gp_original" />
                            <label class="config-option__tab-label" id="lbl_gp_original" for="gp_original">Original</label>
                            <input type="radio" name="gfx_preset" data-checked="gfx_preset" value="enhanced" id="gp_enhanced" />
                            <label class="config-option__tab-label" id="lbl_gp_enhanced" for="gp_enhanced">Enhanced</label>
                            <input type="radio" name="gfx_preset" data-checked="gfx_preset" value="custom" id="gp_custom" data-if="gfx_preset_is_custom" />
                            <label class="config-option__tab-label" id="lbl_gp_custom" for="gp_custom" data-if="gfx_preset_is_custom">Custom</label>
                            <div class="config-option__details">Original: 4:3, 30 fps and the game's draw distance, as on the N64. Enhanced: 16:9, HUD at the edges, 60 fps, no black frame, full draw distance. Choosing one replaces your choices in those rows. Custom means they match neither.</div>
                        </div>
                    </div>
                    <div class="config-option">
                        <label class="config-option__title">Aspect Ratio</label>
                        <div class="config-option__list">
                            <input type="radio" name="aspect" data-checked="aspect" value="original" id="ar_original" />
                            <label class="config-option__tab-label" id="lbl_ar_original" for="ar_original">Original (4:3)</label>
                            <input type="radio" name="aspect" data-checked="aspect" value="expand" id="ar_expand" />
                            <label class="config-option__tab-label" id="lbl_ar_expand" for="ar_expand">Fit window</label>
                            <input type="radio" name="aspect" data-checked="aspect" value="16:9" id="ar_169" />
                            <label class="config-option__tab-label" id="lbl_ar_169" for="ar_169">16:9</label>
                            <input type="radio" name="aspect" data-checked="aspect" value="21:9" id="ar_219" />
                            <label class="config-option__tab-label" id="lbl_ar_219" for="ar_219">21:9</label>
                        </div>
                    </div>
                    <div class="config-option" data-if="show_hud">
                        <label class="config-option__title">HUD Placement</label>
                        <div class="config-option__list">
                            <input type="radio" name="hud" data-checked="hud" value="original" id="hud_original" />
                            <label class="config-option__tab-label" id="lbl_hud_original" for="hud_original">Original (4:3)</label>
                            <input type="radio" name="hud" data-checked="hud" value="16:9" id="hud_169" />
                            <label class="config-option__tab-label" id="lbl_hud_169" for="hud_169">16:9 edges</label>
                            <input type="radio" name="hud" data-checked="hud" value="expand" id="hud_expand" />
                            <label class="config-option__tab-label" id="lbl_hud_expand" for="hud_expand">Screen edges</label>
                            <div class="config-option__details">Where the score, special meter, timer and the like sit when the picture is wider than 4:3. Original keeps them in the 4:3 middle. Menus and pause screens stay centred.</div>
                        </div>
                    </div>
                    <div class="config-option" data-if="show_dd">
                        <label class="config-option__title">Draw Distance</label>
                        <div class="config-option__list">
                            <input type="radio" name="draw_distance" data-checked="draw_distance" value="original" id="dd_original" />
                            <label class="config-option__tab-label" id="lbl_dd_original" for="dd_original">Original</label>
                            <input type="radio" name="draw_distance" data-checked="draw_distance" value="2x" id="dd_2x" />
                            <label class="config-option__tab-label" id="lbl_dd_2x" for="dd_2x">2x</label>
                            <input type="radio" name="draw_distance" data-checked="draw_distance" value="4x" id="dd_4x" />
                            <label class="config-option__tab-label" id="lbl_dd_4x" for="dd_4x">4x</label>
                            <input type="radio" name="draw_distance" data-checked="draw_distance" value="full" id="dd_full" />
                            <label class="config-option__tab-label" id="lbl_dd_full" for="dd_full">Full</label>
                            <div class="config-option__details">How far the course is drawn: Original, 2x, 4x or Full (the whole course). It draws less if the game's buffers fill up. No restart needed. THPS 2 and 3: a longer distance takes full effect after a RETRY, the next course or a camera change.</div>
                        </div>
                    </div>
                    <div class="config-option">
                        <label class="config-option__title">Two-Player Split Screen</label>
                        <div class="config-option__list">
                            <input type="radio" name="split" data-checked="split" value="original" id="split_original" />
                            <label class="config-option__tab-label" id="lbl_split_original" for="split_original">Original (4:3)</label>
                            <input type="radio" name="split" data-checked="split" value="wide" id="split_wide" />
                            <label class="config-option__tab-label" id="lbl_split_wide" for="split_wide">Fill picture</label>
                            <div class="config-option__details">In widescreen, each player's view fills its half of the picture, and each player's score and meter sit at the edge of their own view. Original keeps both views in the 4:3 middle.</div>
                        </div>
                    </div>
                    <div class="config-option">
                        <label class="config-option__title">Picture Border</label>
                        <div class="config-option__list">
                            <input type="radio" name="border" data-checked="border" value="original" id="border_original" />
                            <label class="config-option__tab-label" id="lbl_border_original" for="border_original">Original</label>
                            <input type="radio" name="border" data-checked="border" value="fill" id="border_fill" />
                            <label class="config-option__tab-label" id="lbl_border_fill" for="border_fill">Fill</label>
                            <div class="config-option__details">The game leaves a thin black frame around the 3D picture that a TV hid. Fill puts picture there. Nothing is cut off or zoomed.</div>
                        </div>
                    </div>
                    <div class="config-option">
                        <label class="config-option__title">Resolution</label>
                        <div class="config-option__list">
                            <input type="radio" name="res_scale" data-checked="res_scale" value="0" id="rs_0" />
                            <label class="config-option__tab-label" id="lbl_rs_0" for="rs_0">Auto</label>
                            <input type="radio" name="res_scale" data-checked="res_scale" value="1" id="rs_1" />
                            <label class="config-option__tab-label" id="lbl_rs_1" for="rs_1">1x</label>
                            <input type="radio" name="res_scale" data-checked="res_scale" value="2" id="rs_2" />
                            <label class="config-option__tab-label" id="lbl_rs_2" for="rs_2">2x</label>
                            <input type="radio" name="res_scale" data-checked="res_scale" value="3" id="rs_3" />
                            <label class="config-option__tab-label" id="lbl_rs_3" for="rs_3">3x</label>
                            <input type="radio" name="res_scale" data-checked="res_scale" value="4" id="rs_4" />
                            <label class="config-option__tab-label" id="lbl_rs_4" for="rs_4">4x</label>
                            <div class="config-option__details">Multiple of the original 320x240 image. Auto follows the window.</div>
                        </div>
                    </div>
                    <div class="config-option">
                        <label class="config-option__title">Anti-Aliasing (MSAA)</label>
                        <div class="config-option__list">
                            <input type="radio" name="msaa" data-checked="msaa" value="0" id="ms_0" />
                            <label class="config-option__tab-label" id="lbl_ms_0" for="ms_0">None</label>
                            <input type="radio" name="msaa" data-checked="msaa" value="2" id="ms_2" />
                            <label class="config-option__tab-label" id="lbl_ms_2" for="ms_2">2x</label>
                            <input type="radio" name="msaa" data-checked="msaa" value="4" id="ms_4" />
                            <label class="config-option__tab-label" id="lbl_ms_4" for="ms_4">4x</label>
                            <input type="radio" name="msaa" data-checked="msaa" value="8" id="ms_8" data-if="show_msaa8" />
                            <label class="config-option__tab-label" id="lbl_ms_8" for="ms_8" data-if="show_msaa8">8x</label>
                        </div>
                    </div>
                    <div class="config-option">
                        <label class="config-option__title">Frame Rate</label>
                        <div class="config-option__list">
                            <input type="radio" name="refresh" data-checked="refresh" value="original" id="rr_original" />
                            <label class="config-option__tab-label" id="lbl_rr_original" for="rr_original">Original (30)</label>
                            <input type="radio" name="refresh" data-checked="refresh" value="60" id="rr_60" />
                            <label class="config-option__tab-label" id="lbl_rr_60" for="rr_60">60</label>
                            <div class="config-option__details">Extra frames are interpolated between the game's own.</div>
                        </div>
                    </div>
                    <div class="config-option">
                        <label class="config-option__title">Window Mode</label>
                        <div class="config-option__list">
                            <input type="radio" name="window_mode" data-checked="window_mode" value="windowed" id="wm_windowed" />
                            <label class="config-option__tab-label" id="lbl_wm_windowed" for="wm_windowed">Windowed</label>
                            <input type="radio" name="window_mode" data-checked="window_mode" value="fullscreen" id="wm_fullscreen" />
                            <label class="config-option__tab-label" id="lbl_wm_fullscreen" for="wm_fullscreen">Fullscreen</label>
                        </div>
                    </div>
                            </div>
                        </div>
                    </form>
                </panel>
                <tab class="tab" id="tab_sound">
                    <div>Sound</div>
                    <div class="tab__indicator"></div>
                </tab>
                <panel class="config ctl-panel" data-model="sound_model">
                    <form class="config__form">
                        <div class="config__hz-wrapper">
                            <div class="config__wrapper ctl-scroll">
                    <div class="config-option">
                        <label class="config-option__title">Main Volume</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{main_volume}}%</label>
                            <input class="nav-vert" id="main_volume_input" type="range" min="0" max="100" style="flex: 1; margin: 0dp;" data-value="main_volume" />
                        </div>
                    </div>
                            </div>
                        </div>
                    </form>
                </panel>
                <tab class="tab" id="tab_cheats">
                    <div>Cheats</div>
                    <div class="tab__indicator"></div>
                </tab>
                <panel class="config ctl-panel" data-model="cheats_model">
                    <form class="config__form">
                        <div class="config__hz-wrapper">
                            <div class="config__wrapper ctl-scroll">
                    <div class="config-option">
                        <p>Test aids for play testing, all off by default. They aren't stored in your Controller Pak save, but progress you make with one on is saved as usual. The log and crash.log name the ones that are on.</p>
                    </div>
                    <div class="config-option" data-if="has_unlock_levels">
                        <label class="config-option__title">{{title_unlock_levels}}</label>
                        <div class="config-option__list">
                            <input type="radio" name="unlock_levels" data-checked="unlock_levels" value="On" id="ch_ul_On" />
                            <label class="config-option__tab-label" id="lbl_ch_ul_On" for="ch_ul_On">On</label>
                            <input type="radio" name="unlock_levels" data-checked="unlock_levels" value="Off" id="ch_ul_Off" />
                            <label class="config-option__tab-label" id="lbl_ch_ul_Off" for="ch_ul_Off">Off</label>
                            <div class="config-option__details">{{note_unlock_levels}}</div>
                        </div>
                    </div>
                    <div class="config-option" data-if="has_perfect_balance">
                        <label class="config-option__title">{{title_perfect_balance}}</label>
                        <div class="config-option__list">
                            <input type="radio" name="perfect_balance" data-checked="perfect_balance" value="On" id="ch_pb_On" />
                            <label class="config-option__tab-label" id="lbl_ch_pb_On" for="ch_pb_On">On</label>
                            <input type="radio" name="perfect_balance" data-checked="perfect_balance" value="Off" id="ch_pb_Off" />
                            <label class="config-option__tab-label" id="lbl_ch_pb_Off" for="ch_pb_Off">Off</label>
                            <div class="config-option__details">{{note_perfect_balance}}</div>
                        </div>
                    </div>
                    <div class="config-option" data-if="has_slow_motion">
                        <label class="config-option__title">{{title_slow_motion}}</label>
                        <div class="config-option__list">
                            <input type="radio" name="slow_motion" data-checked="slow_motion" value="On" id="ch_sm_On" />
                            <label class="config-option__tab-label" id="lbl_ch_sm_On" for="ch_sm_On">On</label>
                            <input type="radio" name="slow_motion" data-checked="slow_motion" value="Off" id="ch_sm_Off" />
                            <label class="config-option__tab-label" id="lbl_ch_sm_Off" for="ch_sm_Off">Off</label>
                            <div class="config-option__details">{{note_slow_motion}}</div>
                        </div>
                    </div>
                    <div class="config-option" data-if="has_skip_to_restart">
                        <label class="config-option__title">{{title_skip_to_restart}}</label>
                        <div class="config-option__list">
                            <input type="radio" name="skip_to_restart" data-checked="skip_to_restart" value="On" id="ch_sr_On" />
                            <label class="config-option__tab-label" id="lbl_ch_sr_On" for="ch_sr_On">On</label>
                            <input type="radio" name="skip_to_restart" data-checked="skip_to_restart" value="Off" id="ch_sr_Off" />
                            <label class="config-option__tab-label" id="lbl_ch_sr_Off" for="ch_sr_Off">Off</label>
                            <div class="config-option__details">{{note_skip_to_restart}}</div>
                        </div>
                    </div>
                    <div class="config-option" data-if="has_always_special">
                        <label class="config-option__title">{{title_always_special}}</label>
                        <div class="config-option__list">
                            <input type="radio" name="always_special" data-checked="always_special" value="On" id="ch_as_On" />
                            <label class="config-option__tab-label" id="lbl_ch_as_On" for="ch_as_On">On</label>
                            <input type="radio" name="always_special" data-checked="always_special" value="Off" id="ch_as_Off" />
                            <label class="config-option__tab-label" id="lbl_ch_as_Off" for="ch_as_Off">Off</label>
                            <div class="config-option__details">{{note_always_special}}</div>
                        </div>
                    </div>
                            </div>
                        </div>
                    </form>
                </panel>
                </tabset>
                <div class="config__icon-buttons">
                    <button class="icon-button" onclick="close_menu" id="config__close-menu-button">
                        <svg src="icons/X.svg" />
                    </button>
                </div>
            </div>
            <div class="centered-page__controls">
                <label><span>Close</span> <span class="prompt-font-sm">Esc</span></label>
                <label><span>Move</span> <span class="prompt-font-sm">Arrows / D-pad</span></label>
                <label><span>Choose</span> <span class="prompt-font-sm">Enter / A</span></label>
                <label><span>Tabs</span> <span class="prompt-font-sm">LB / RB</span></label>
            </div>
        </div>
    </div>
</body>
</rml>
