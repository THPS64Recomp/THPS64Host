<rml>
<head>
    <link type="text/rcss" href="rml.rcss"/>
    <link type="text/rcss" href="recomp.rcss"/>
    <title>Hint</title>
    <style>
        body { width: 100%; height: 100%; }
        .hint { position: absolute; left: 40dp; bottom: 40dp; padding: 14dp 22dp; border-radius: 12dp;
                background-color: rgba(8, 7, 13, 217); color: #F2F2F2; font-family: LatoLatin; font-size: 26dp; }
    </style>
</head>
<body>
    <div class="hint">Press Esc (controller: Back) for Settings</div>
</body>
</rml>
